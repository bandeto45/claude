{
  "version": "1.0",
  "project": {
    "name": "claude-config-template",
    "description": "Reusable AI assistant configuration (agents, rules, commands, hooks, skills) for TypeScript full-stack apps"
  },
  "agents": {
    "enabled": true,
    "directory": ".claude/agents"
  },
  "commands": {
    "enabled": true,
    "directory": ".claude/commands"
  },
  "hooks": {
    "enabled": true,
    "pre_commit": ".claude/hooks/pre-commit.sh",
    "post_tool_use": ".claude/hooks/lint-on-save.sh"
  },
  "rules": {
    "enabled": true,
    "directory": ".claude/rules",
    "autoApply": {
      "frontend.md": [
        "src/components/**",
        "src/features/**",
        "src/hooks/**",
        "src/app/**/*.tsx"
      ],
      "api.md": ["src/app/api/**", "src/server/**", "src/actions/**"],
      "database.md": ["src/lib/db/**", "prisma/**", "**/*repository*"],
      "security.md": [
        "src/app/api/**",
        "src/server/**",
        "src/actions/**",
        "src/lib/auth/**",
        "src/middleware.ts",
        "middleware.ts"
      ],
      "observability.md": [
        "src/lib/logger/**",
        "src/lib/logging/**",
        "src/lib/observability/**",
        "**/logger*.ts",
        "src/instrumentation.ts",
        "instrumentation.ts"
      ],
      "testing.md": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/e2e/**",
        "**/__tests__/**"
      ]
    }
  },
  "skills": {
    "enabled": true,
    "directory": ".claude/skills"
  },
  "behavior": {
    "alwaysReadClaudeMd": true,
    "preferEditOverCreate": true,
    "confirmDestructiveActions": true,
    "autoRunLintOnSave": true,
    "verbosity": "concise"
  },
  "ignore": [
    "node_modules/**",
    ".next/**",
    "dist/**",
    "build/**",
    "coverage/**",
    "*.lock",
    ".env",
    ".env.*",
    "!.env.example"
  ]
}
